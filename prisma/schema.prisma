// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String        @id
  isPrimary   Boolean       @unique @default(true)
  name        String
  description String
  skills      Skill[]
  links       Link[]
  experiences Experience[]
  projects    Project[]
}

model Link {
  id        String    @id
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      LinkKind
  url       String
  label     String?
  sortOrder Int

  @@index([profileId])
}

model Skill {
  id        String    @id
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  sortOrder Int

  @@unique([profileId, name])
}

model Experience {
  id            String    @id
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company       String
  position      String
  startDate     String
  endDate       String?
  achievements  String[]  @default([])
  sortOrder     Int

  @@index([profileId])
}

model Project {
  id          String    @id
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  url         String?
  description String?
  sortOrder   Int

  @@index([profileId])
}

enum LinkKind {
  GITHUB
  TELEGRAM
  OTHER
}